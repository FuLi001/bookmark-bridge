{
  "manifest_version": 3,
  "name": "Bookmark Bridge",
  "version": "1.0.1",
  "description": "在本机双向同步指定的 Chrome 与 Safari 书签目录。",
  "permissions": ["bookmarks", "alarms"],
  "host_permissions": ["http://127.0.0.1:17315/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bookmark Bridge"
  }
}
